{
  "name": "mjolnir",
  "version": "0.1.3",
  "description": "Mjolnir: segmented, resumable download manager",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:live": "node test/ytdlp.live.test.js",
    "test": "node test/engine.test.js && node test/hls.test.js && node test/dash.test.js && node test/screener.test.js && node test/youtube.test.js && node test/phonelink.test.js && node test/audio-extractor.test.js && node test/updates.test.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "qrcode": "^1.5.4"
  },
  "author": "Mjolnir",
  "build": {
    "appId": "com.mjolnir.downloader",
    "productName": "Mjolnir",
    "copyright": "Mjolnir",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.md",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Mjolnir-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Mjolnir-Portable-${version}.${ext}"
    }
  },
  "productName": "Mjolnir"
}